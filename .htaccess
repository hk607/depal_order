<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.env|\.git|\.svn|\.hg|composer\.json|composer\.lock|package\.json|package-lock\.json|phpunit\.xml|\.php_cs|\.editorconfig">
    Require all denied
</FilesMatch>